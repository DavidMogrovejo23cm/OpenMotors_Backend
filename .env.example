# Seguridad: genera una clave aleatoria de al menos 32 caracteres.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480
APP_ENV=development

# Orígenes web que pueden consumir la API, separados por comas.
ALLOWED_ORIGINS=http://localhost:5173,https://openmotor.vercel.app

# Solo para crear el primer administrador en una base vacía. No se guardan en la base si ya existe un ADMIN.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Nunca habilitar en producción: crea cuentas demo conocidas.
SEED_DEMO_DATA=false
